{
  "entities": {
    "User": {
      "title": "User",
      "description": "System users including super_admin, owner, leader, and kasir",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "owner", "leader", "kasir"] },
        "toko_id": { "type": "string", "description": "Null for super_admin" },
        "cabang_id": { "type": "string", "description": "Null for super_admin and owner" }
      },
      "required": ["uid", "email", "name", "role"]
    },
    "Toko": {
      "title": "Toko",
      "description": "Tenant definition representing a store or business",
      "type": "object",
      "properties": {
        "toko_id": { "type": "string" },
        "nama_toko": { "type": "string" },
        "owner_id": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["toko_id", "nama_toko", "owner_id", "status", "created_at"]
    },
    "Cabang": {
      "title": "Cabang",
      "description": "Store branches belonging to a specific Toko",
      "type": "object",
      "properties": {
        "cabang_id": { "type": "string" },
        "toko_id": { "type": "string" },
        "nama_cabang": { "type": "string" },
        "alamat": { "type": "string" }
      },
      "required": ["cabang_id", "toko_id", "nama_cabang", "alamat"]
    },
    "Menu": {
      "title": "Menu",
      "description": "Products available for sale, specified per Cabang",
      "type": "object",
      "properties": {
        "menu_id": { "type": "string" },
        "toko_id": { "type": "string" },
        "cabang_id": { "type": "string" },
        "nama_produk": { "type": "string" },
        "harga": { "type": "number" },
        "stok": { "type": "number" }
      },
      "required": ["menu_id", "toko_id", "cabang_id", "nama_produk", "harga", "stok"]
    },
    "Transaksi": {
      "title": "Transaksi",
      "description": "Transaction records scoped to a Cabang",
      "type": "object",
      "properties": {
        "transaksi_id": { "type": "string" },
        "cabang_id": { "type": "string" },
        "kasir_id": { "type": "string" },
        "role_eksekutor": { "type": "string", "enum": ["super_admin", "owner", "leader", "kasir"] },
        "total_bayar": { "type": "number" },
        "system_datetime": { "type": "string", "format": "date-time" },
        "business_date": { "type": "string", "description": "YYYY-MM-DD" },
        "status_transaksi": { "type": "string", "enum": ["success", "deleted"] },
        "deleted_at": { "type": "string", "format": "date-time" },
        "deleted_by": { "type": "string" }
      },
      "required": ["transaksi_id", "cabang_id", "kasir_id", "role_eksekutor", "total_bayar", "system_datetime", "business_date", "status_transaksi"]
    }
  },
  "firestore": {
    "users": {
      "schema": { "$ref": "User" },
      "description": "Root collection for all users"
    },
    "toko": {
      "schema": { "$ref": "Toko" },
      "description": "Root collection for tenants/stores"
    },
    "cabang": {
      "schema": { "$ref": "Cabang" },
      "description": "Root collection for branches"
    },
    "menu": {
      "schema": { "$ref": "Menu" },
      "description": "Root collection for products/menu items"
    },
    "transaksi": {
      "schema": { "$ref": "Transaksi" },
      "description": "Root collection for transactions/orders"
    }
  }
}
